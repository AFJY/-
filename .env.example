# Copy values into ~/.hermes/.env (hermes config set KEY value)

# --- Required for DeepSeek chat ---
DEEPSEEK_API_KEY=sk-your-deepseek-key-here

# --- Web search (ddgs is free; paid alternatives optional) ---
# TAVILY_API_KEY=
# EXA_API_KEY=
# FIRECRAWL_API_KEY=
# PARALLEL_API_KEY=
# BRAVE_SEARCH_API_KEY=

# --- Image / video generation ---
# FAL_KEY=

# --- Messaging platforms (hermes gateway setup) ---
# TELEGRAM_BOT_TOKEN=
# DISCORD_BOT_TOKEN=
# SLACK_BOT_TOKEN=
# SLACK_APP_TOKEN=

# --- Other providers / tools ---
# OPENROUTER_API_KEY=
# XAI_API_KEY=
# GITHUB_TOKEN=
# HASS_URL=
# HASS_TOKEN=

# Optional overrides
# DEEPSEEK_MODEL=deepseek-v4-pro
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
